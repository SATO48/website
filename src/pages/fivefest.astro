---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { href } from "../lib/paths";
import { accentColor, getSingleton, heading, inline } from "../lib/content";

// Copy and images come from Keystatic: Pages → FiveFest.
const { seo, header, status, photo, stats, guidelines, genres, tiers, dates, finePrint } = await getSingleton("fivefest");
---

<Layout title={seo.title} description={seo.description}>
<div style="font-family: Inter, Arial, sans-serif; background: #0A0E1A; color: #FFFFFF; line-height: 1.5; min-width: 0">

<div style="position: sticky; top: 0; z-index: 10">
<Nav />
</div>

<header style="padding: 32px 0 56px; border-bottom: 1px solid #1E2638">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<nav aria-label="Breadcrumb" style="font-size: 14px; color: #B9B9C6; margin-bottom: 40px"><a href={href("/")} style="color: #B9B9C6; text-decoration: none">Home</a> <span aria-hidden="true" style="margin: 0 6px">/</span> <span aria-current="page" style="color: #E6E6EE">{header.title}</span></nav>
<div style="display: flex; flex-wrap: wrap; gap: 40px 56px; align-items: end">
<div style="flex: 1 1 480px; min-width: 0">
<img src={href(header.logo)} alt="" style="display: block; height: 44px; width: auto; background: #FFFFFF; padding: 6px 10px; border-radius: 8px; margin-bottom: 16px">
<h1 style="margin: 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(36px, 4.5vw, 56px)">{header.title}</h1>
<p style="font-size: 18px; color: #E3E3EA; margin: 16px 0 0; max-width: 52ch">{header.intro}</p>
</div>
<aside style="flex: 0 1 380px; min-width: 0; background: #141B2D; border: 1px solid #232C40; border-radius: 18px; padding: 24px">
<p style="display: flex; align-items: center; gap: 10px; margin: 0 0 8px; font-weight: 800"><span aria-hidden="true" style="width: 10px; height: 10px; border-radius: 999px; background: #FF6C00"></span>{status.label}</p>
<dl style="margin: 0 0 20px">
{status.dates.map((d, i) => (
<div style={`display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: ${i < status.dates.length - 1 ? "1px solid #232C40" : "0"}`}><dt style="color: #B9B9C6">{d.label}</dt><dd style="margin: 0; font-weight: 800; text-align: right">{d.value}</dd></div>
))}
</dl>
<div style="display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center"><a class="btn-primary" href={href(status.button.href)} style="display: inline-flex; align-items: center; gap: 8px; font-weight: 800; text-decoration: none; border-radius: 999px; padding: 10px 18px; font-size: 14px; letter-spacing: .02em; background: #FF6C00; color: #0A0E1A; border: 3px solid #0A0E1A; box-shadow: 3px 3px 0 #3996B1">{status.button.label}</a><a href="#guidelines" style="font-weight: 800; font-size: 14px; text-decoration: none; color: #E6E6EE">{status.guidelinesLabel}</a></div>
</aside>
</div>
</div>
</header>

<section style="padding: 48px 0 0">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<figure style="margin: 0">
<img src={href(photo.image)} alt={photo.alt} style="display: block; width: 100%; aspect-ratio: 21/9; object-fit: cover; object-position: 50% 42%; border-radius: 18px; border: 1px solid #28324A; box-shadow: 12px 12px 0 #3996B1">
{photo.caption && <figcaption style="margin-top: 20px; font-size: 14px; color: #B9B9C6">{photo.caption}</figcaption>}
</figure>
</div>
</section>

<section class="band" style="padding: 64px 0">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<dl style="margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 24px">
{stats.map((s) => (
<div><dt style={`font-family: 'Archivo Black', 'Arial Black', sans-serif; font-size: 56px; line-height: 1; color: ${accentColor[s.accent]}`}>{s.value}</dt><dd style="margin: 8px 0 0; color: #CFCFDA">{s.label}</dd></div>
))}
</dl>
</div>
</section>

<section id="guidelines" class="band paper" style="padding: 88px 0; background: #FAF7F0; color: #0A0E1A">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<div style="display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 24px; margin-bottom: 40px">
<div>
<span style="font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #1F6E87">{guidelines.eyebrow}</span>
<h2 style="margin: 12px 0 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(32px, 4vw, 48px)" set:html={heading(guidelines.heading)} />
</div>
<p style="margin: 0; color: #2B2B33; max-width: 46ch">{guidelines.intro}</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px">
{guidelines.cards.map((card) => (
<article style="background: #FFFFFF; border: 1px solid #EEEEEE; border-radius: 18px; padding: 28px">
<h3 style="margin: 0 0 12px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 22px; line-height: 1.1">{card.title}</h3>
<ul style="margin: 0; padding-left: 20px; display: grid; gap: 6px; color: #2B2B33">
{card.points.map((point) => <li>{point}</li>)}
</ul>
</article>
))}
</div>
</div>
</section>

<section class="band" style="padding: 88px 0">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<div style="display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 24px; margin-bottom: 40px">
<h2 style="margin: 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(32px, 4vw, 48px)" set:html={heading(genres.heading)} />
<p style="margin: 0; color: #B9B9C6; max-width: 46ch">{genres.intro}</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px">
{genres.items.map((g) => (
<article style="background: #141B2D; border: 1px solid #232C40; border-radius: 18px; padding: 24px"><h3 style="margin: 0 0 10px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 22px">{g.name}</h3><ul style="margin: 0; padding-left: 18px; color: #CFCFDA; display: grid; gap: 4px; font-size: 15px">{g.criteria.map((c) => <li>{c}</li>)}</ul></article>
))}
</div>
<p style="margin: 32px 0 0"><a href={href(genres.link.href)} style="font-weight: 800; text-decoration: none; color: #FF6C00">{genres.link.label}</a></p>
</div>
</section>

<section class="band" style="padding: 88px 0; background: #141B2D">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<h2 style="margin: 0 0 40px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(32px, 4vw, 48px)" set:html={heading(tiers.heading)} />
<ol style="list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 24px">
{tiers.items.map((t) => (
<li style={`flex: 1 1 280px; min-width: 0; background: #0A0E1A; border-radius: 18px; padding: 28px; ${t.featured ? "border: 1px solid #FF6C00; box-shadow: 5px 5px 0 #3996B1" : "border: 1px solid #28324A"}`}>
<p style={`margin: 0 0 8px; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: ${t.featured ? "#FF6C00" : "#3996B1"}`}>{t.eyebrow}</p>
<h3 style="margin: 0 0 10px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 24px; line-height: 1.05">{t.title}</h3>
<p style="margin: 0; color: #CFCFDA">{t.body}</p>
</li>
))}
</ol>
{tiers.note && <p style="margin: 24px 0 0; color: #B9B9C6">{tiers.note}</p>}
</div>
</section>

<section class="band" style="padding: 88px 0">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 48px">
<div style="flex: 1 1 360px; min-width: 0">
<h2 style="margin: 0 0 24px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(30px, 3.6vw, 40px)" set:html={heading(dates.heading)} />
<dl style="margin: 0; display: grid; gap: 16px">
{dates.items.map((d, i) => (
<div style={`display: flex; flex-wrap: wrap; gap: 4px 16px${i < dates.items.length - 1 ? "; border-bottom: 1px solid #1E2638; padding-bottom: 16px" : ""}`}><dt style="flex: 0 0 180px; font-weight: 800; color: #3996B1">{d.label}</dt><dd style="margin: 0; flex: 1 1 160px; color: #E3E3EA">{d.value}</dd></div>
))}
</dl>
</div>
<div style="flex: 1 1 360px; min-width: 0">
<h2 style="margin: 0 0 24px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(30px, 3.6vw, 40px)" set:html={heading(finePrint.heading)} />
<div class="fine-print" set:html={finePrint.body} />
<p class="fine-print-contact" style="margin: 24px 0 0; color: #E3E3EA" set:html={inline(finePrint.contact)} />
<p style="margin: 12px 0 0"><a href={href(finePrint.link.href)} style="font-weight: 800; text-decoration: none; color: #FF6C00">{finePrint.link.label}</a></p>
</div>
</div>
</section>

<Footer />

</div>
</Layout>

<style is:global>
.paper a:hover{color:#1F6E87}
/* Fine print and contact line (rich text from Keystatic) */
.fine-print ul,.fine-print ol{margin:0;padding-left:20px;display:grid;gap:10px;color:#CFCFDA}
.fine-print p{margin:0 0 10px;color:#CFCFDA}
.fine-print strong{color:#FFFFFF}
.fine-print-contact a{font-weight:800;color:#FF6C00}
.fine-print-contact a:hover{color:#FFFFFF}
</style>
