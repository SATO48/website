---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { url, img } from "../lib/paths";
---

<Layout title="FiveFest: Five Minute Film Festival · SATO48" description="Films of five minutes or less, in any of eight genres, from filmmakers anywhere. Every film is scored by our Academy Judges and screens online; the best play the big screen in Springfield.">
<div style="font-family: Inter, Arial, sans-serif; background: #0A0E1A; color: #FFFFFF; line-height: 1.5; min-width: 0">

<div style="position: sticky; top: 0; z-index: 10">
<Nav current="fivefest" />
</div>

<header style="padding: 32px 0 56px; border-bottom: 1px solid #1E2638">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<nav aria-label="Breadcrumb" style="font-size: 14px; color: #B9B9C6; margin-bottom: 40px"><a href={url("")} style="color: #B9B9C6; text-decoration: none">Home</a> <span aria-hidden="true" style="margin: 0 6px">/</span> <span aria-current="page" style="color: #E6E6EE">FiveFest</span></nav>
<div style="display: flex; flex-wrap: wrap; gap: 40px 56px; align-items: end">
<div style="flex: 1 1 480px; min-width: 0">
<img src={img("f162ec5eeede26d210b14b591a35d743.png")} alt="" style="display: block; height: 44px; width: auto; background: #FFFFFF; padding: 6px 10px; border-radius: 8px; margin-bottom: 16px">
<h1 style="margin: 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(36px, 4.5vw, 56px)">FiveFest</h1>
<p style="font-size: 18px; color: #E3E3EA; margin: 16px 0 0; max-width: 52ch">The Five Minute Film Festival: films of five minutes or less, in any of eight genres, from filmmakers anywhere. Every film gets in, gets scored by our Academy Judges and screens online. The best play the big screen in Springfield.</p>
</div>
<aside style="flex: 0 1 380px; min-width: 0; background: #141B2D; border: 1px solid #232C40; border-radius: 18px; padding: 24px">
<p style="display: flex; align-items: center; gap: 10px; margin: 0 0 8px; font-weight: 800"><span aria-hidden="true" style="width: 10px; height: 10px; border-radius: 999px; background: #FF6C00"></span>2026 submissions are closed</p>
<dl style="margin: 0 0 20px">
<div style="display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid #232C40"><dt style="color: #B9B9C6">2027 submissions open</dt><dd style="margin: 0; font-weight: 800; text-align: right">[ANNOUNCE DATE]</dd></div>
<div style="display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 0"><dt style="color: #B9B9C6">Awards Ceremony</dt><dd style="margin: 0; font-weight: 800; text-align: right">Second week of October</dd></div>
</dl>
<div style="display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center"><a class="btn-primary" href="https://portal.sato48.com/archive/fivefest" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 800; text-decoration: none; border-radius: 999px; padding: 10px 18px; font-size: 14px; letter-spacing: .02em; background: #FF6C00; color: #0A0E1A; border: 3px solid #0A0E1A; box-shadow: 3px 3px 0 #3996B1">▶ Watch FiveFest films</a><a href="#guidelines" style="font-weight: 800; font-size: 14px; text-decoration: none; color: #E6E6EE">Guidelines ↓</a></div>
</aside>
</div>
</div>
</header>

<section style="padding: 48px 0 0">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<figure style="margin: 0">
<img src={img("eb7baeac3b1cb480f2e56aa707f0b0e1.jpg")} alt="The Gillioz Theatre marquee in Springfield reading FiveFest, SATO48, Oct. 24, 6 PM" style="display: block; width: 100%; aspect-ratio: 21/9; object-fit: cover; object-position: 50% 42%; border-radius: 18px; border: 1px solid #28324A; box-shadow: 12px 12px 0 #3996B1">
<figcaption style="margin-top: 20px; font-size: 14px; color: #B9B9C6">FiveFest on the Gillioz marquee, Springfield, Missouri.</figcaption>
</figure>
</div>
</section>

<section class="band" style="padding: 64px 0">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<dl style="margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px">
<div style="border-left: 0; padding: 0"><dt style="font-family: 'Archivo Black', 'Arial Black', sans-serif; font-size: 56px; line-height: 1; color: #FF6C00">5:00</dt><dd style="margin: 8px 0 0; color: #CFCFDA">Maximum length, credits included.</dd></div>
<div><dt style="font-family: 'Archivo Black', 'Arial Black', sans-serif; font-size: 56px; line-height: 1; color: #3996B1">8</dt><dd style="margin: 8px 0 0; color: #CFCFDA">Genres, each with its own Best award.</dd></div>
<div><dt style="font-family: 'Archivo Black', 'Arial Black', sans-serif; font-size: 56px; line-height: 1; color: #FFFFFF">720p</dt><dd style="margin: 8px 0 0; color: #CFCFDA">Minimum resolution, with clear audio.</dd></div>
<div><dt style="font-family: 'Archivo Black', 'Arial Black', sans-serif; font-size: 56px; line-height: 1; color: #FFFFFF">100%</dt><dd style="margin: 8px 0 0; color: #CFCFDA">Of complete, eligible films are accepted.</dd></div>
</dl>
</div>
</section>

<section id="guidelines" class="band paper" style="padding: 88px 0; background: #FAF7F0; color: #0A0E1A">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<div style="display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 24px; margin-bottom: 40px">
<div>
<span style="font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #1F6E87">2026 guidelines</span>
<h2 style="margin: 12px 0 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(32px, 4vw, 48px)">What to send us.</h2>
</div>
<p style="margin: 0; color: #2B2B33; max-width: 46ch">FiveFest is presented by Hlabeard Productions with the SATO48 Film Challenge. Film Challenge teams get a free FiveFest submission with registration.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px">
<article style="background: #FFFFFF; border: 1px solid #EEEEEE; border-radius: 18px; padding: 28px">
<h3 style="margin: 0 0 12px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 22px; line-height: 1.1">Your film</h3>
<ul style="margin: 0; padding-left: 20px; display: grid; gap: 6px; color: #2B2B33">
<li>Five minutes or less, credits included. Longer files can't be uploaded.</li>
<li>Complete and ready for theater projection. No works in progress.</li>
<li>Non-English dialogue needs English subtitles or an English dub.</li>
</ul>
</article>
<article style="background: #FFFFFF; border: 1px solid #EEEEEE; border-radius: 18px; padding: 28px">
<h3 style="margin: 0 0 12px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 22px; line-height: 1.1">Technical</h3>
<ul style="margin: 0; padding-left: 20px; display: grid; gap: 6px; color: #2B2B33">
<li>720p minimum resolution.</li>
<li>Clear audio.</li>
<li>A poster and other promotional materials are encouraged, not required.</li>
</ul>
</article>
<article style="background: #FFFFFF; border: 1px solid #EEEEEE; border-radius: 18px; padding: 28px">
<h3 style="margin: 0 0 12px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 22px; line-height: 1.1">Who can enter</h3>
<ul style="margin: 0; padding-left: 20px; display: grid; gap: 6px; color: #2B2B33">
<li>Any filmmaker, any age, anywhere.</li>
<li>No limit on when the film was made.</li>
<li>Submit through FilmFreeway.</li>
</ul>
</article>
</div>
</div>
</section>

<section class="band" style="padding: 88px 0">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<div style="display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 24px; margin-bottom: 40px">
<h2 style="margin: 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(32px, 4vw, 48px)">Eight genres. Eight awards.</h2>
<p style="margin: 0; color: #B9B9C6; max-width: 46ch">Industry professionals and filmmaking community members judge every entry. Last year's registered Film Challenge team members can join as Academy Judges.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px">
<article style="background: #141B2D; border: 1px solid #232C40; border-radius: 18px; padding: 24px"><h3 style="margin: 0 0 10px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 22px">Animation</h3><ul style="margin: 0; padding-left: 18px; color: #CFCFDA; display: grid; gap: 4px; font-size: 15px"><li>Innovative animation techniques</li><li>Storytelling and emotional impact</li><li>Artistic merit and design</li><li>Voice performances</li></ul></article>
<article style="background: #141B2D; border: 1px solid #232C40; border-radius: 18px; padding: 24px"><h3 style="margin: 0 0 10px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 22px">Comedy</h3><ul style="margin: 0; padding-left: 18px; color: #CFCFDA; display: grid; gap: 4px; font-size: 15px"><li>Original, well-written script</li><li>Comedic timing and delivery</li><li>Ensemble chemistry</li><li>Direction that lands the humor</li></ul></article>
<article style="background: #141B2D; border: 1px solid #232C40; border-radius: 18px; padding: 24px"><h3 style="margin: 0 0 10px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 22px">Documentary</h3><ul style="margin: 0; padding-left: 18px; color: #CFCFDA; display: grid; gap: 4px; font-size: 15px"><li>Depth of subject and research</li><li>Narrative structure and pacing</li><li>Cinematography and visual cohesion</li><li>Impact, originality and insight</li></ul></article>
<article style="background: #141B2D; border: 1px solid #232C40; border-radius: 18px; padding: 24px"><h3 style="margin: 0 0 10px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 22px">Drama</h3><ul style="margin: 0; padding-left: 18px; color: #CFCFDA; display: grid; gap: 4px; font-size: 15px"><li>Complex characters and story</li><li>Quality of performances</li><li>Direction and pacing</li><li>Cinematic craft</li></ul></article>
<article style="background: #141B2D; border: 1px solid #232C40; border-radius: 18px; padding: 24px"><h3 style="margin: 0 0 10px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 22px">Experimental</h3><ul style="margin: 0; padding-left: 18px; color: #CFCFDA; display: grid; gap: 4px; font-size: 15px"><li>Innovation in technique</li><li>Narrative and conceptual ambiguity</li><li>Visual and aural design</li><li>Engagement and provocation</li></ul></article>
<article style="background: #141B2D; border: 1px solid #232C40; border-radius: 18px; padding: 24px"><h3 style="margin: 0 0 10px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 22px">Horror</h3><ul style="margin: 0; padding-left: 18px; color: #CFCFDA; display: grid; gap: 4px; font-size: 15px"><li>Fear, suspense and thrill</li><li>Original concept and execution</li><li>Technical craft of atmosphere</li><li>Depth of story</li></ul></article>
<article style="background: #141B2D; border: 1px solid #232C40; border-radius: 18px; padding: 24px"><h3 style="margin: 0 0 10px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 22px">Music Video</h3><ul style="margin: 0; padding-left: 18px; color: #CFCFDA; display: grid; gap: 4px; font-size: 15px"><li>Creative, original visuals</li><li>Music and image working together</li><li>Direction and choreography</li><li>Technical quality</li></ul></article>
<article style="background: #141B2D; border: 1px solid #232C40; border-radius: 18px; padding: 24px"><h3 style="margin: 0 0 10px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 22px">Musical</h3><ul style="margin: 0; padding-left: 18px; color: #CFCFDA; display: grid; gap: 4px; font-size: 15px"><li>Music woven into the story</li><li>Quality of the numbers</li><li>Choreography and staging</li><li>Direction of musical sequences</li></ul></article>
</div>
<p style="margin: 32px 0 0"><a href={url("resources/fivefest-guidelines-2026/")} style="font-weight: 800; text-decoration: none; color: #FF6C00">Full judging criteria by genre →</a></p>
</div>
</section>

<section class="band" style="padding: 88px 0; background: #141B2D">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<h2 style="margin: 0 0 40px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(32px, 4vw, 48px)">Every film gets seen.</h2>
<ol style="list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 24px">
<li style="flex: 1 1 280px; min-width: 0; background: #0A0E1A; border: 1px solid #28324A; border-radius: 18px; padding: 28px">
<p style="margin: 0 0 8px; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #3996B1">Accepted · every film</p>
<h3 style="margin: 0 0 10px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 24px; line-height: 1.05">Scorecard + online screening</h3>
<p style="margin: 0; color: #CFCFDA">A FiveFest Scorecard showing how the Academy Judges responded, plus an exclusive month-long online screening.</p>
</li>
<li style="flex: 1 1 280px; min-width: 0; background: #0A0E1A; border: 1px solid #28324A; border-radius: 18px; padding: 28px">
<p style="margin: 0 0 8px; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #3996B1">Selected</p>
<h3 style="margin: 0 0 10px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 24px; line-height: 1.05">Big screen + nomination</h3>
<p style="margin: 0; color: #CFCFDA">An in-theater screening at a festival location, and recognition as a Nominee at the October FiveFest Awards Ceremony.</p>
</li>
<li style="flex: 1 1 280px; min-width: 0; background: #0A0E1A; border: 1px solid #FF6C00; border-radius: 18px; padding: 28px; box-shadow: 5px 5px 0 #3996B1">
<p style="margin: 0 0 8px; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #FF6C00">Genre winner</p>
<h3 style="margin: 0 0 10px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 24px; line-height: 1.05">Statuette + the stage</h3>
<p style="margin: 0; color: #CFCFDA">With a representative checked in at the ceremony: a statuette, an on-stage acceptance speech and a backstage interview.</p>
</li>
</ol>
<p style="margin: 24px 0 0; color: #B9B9C6">Filmmakers are told their film's acceptance level by email.</p>
</div>
</section>

<section class="band" style="padding: 88px 0">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 48px">
<div style="flex: 1 1 360px; min-width: 0">
<h2 style="margin: 0 0 24px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(30px, 3.6vw, 40px)">2026 dates &amp; venue.</h2>
<dl style="margin: 0; display: grid; gap: 16px">
<div style="display: flex; flex-wrap: wrap; gap: 4px 16px; border-bottom: 1px solid #1E2638; padding-bottom: 16px"><dt style="flex: 0 0 180px; font-weight: 800; color: #3996B1">Submissions close</dt><dd style="margin: 0; color: #E3E3EA">September 1, 2026</dd></div>
<div style="display: flex; flex-wrap: wrap; gap: 4px 16px; border-bottom: 1px solid #1E2638; padding-bottom: 16px"><dt style="flex: 0 0 180px; font-weight: 800; color: #3996B1">Awards Ceremony</dt><dd style="margin: 0; color: #E3E3EA">Second week of October</dd></div>
<div style="display: flex; flex-wrap: wrap; gap: 4px 16px; border-bottom: 1px solid #1E2638; padding-bottom: 16px"><dt style="flex: 0 0 180px; font-weight: 800; color: #3996B1">In-theater screenings</dt><dd style="margin: 0; color: #E3E3EA">Scheduled around venue capacity</dd></div>
<div style="display: flex; flex-wrap: wrap; gap: 4px 16px"><dt style="flex: 0 0 180px; font-weight: 800; color: #3996B1">Venue</dt><dd style="margin: 0; color: #E3E3EA">Alamo Drafthouse Cinema, Springfield, Missouri, the largest Alamo Drafthouse in the United States. Wheelchair accessible.</dd></div>
</dl>
</div>
<div style="flex: 1 1 360px; min-width: 0">
<h2 style="margin: 0 0 24px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(30px, 3.6vw, 40px)">The fine print.</h2>
<ul style="margin: 0; padding-left: 20px; display: grid; gap: 10px; color: #CFCFDA">
<li><strong style="color: #FFFFFF">Rights.</strong> You must own all rights to your film. You grant Hlabeard Productions and SATO48 in-theater and paywalled online screening rights for the festival, plus free online use in Festival Manager and promotional use in perpetuity.</li>
<li><strong style="color: #FFFFFF">Endorsement.</strong> Acceptance isn't an endorsement of a film's content.</li>
<li><strong style="color: #FFFFFF">Liability.</strong> Hlabeard Productions and SATO48 aren't liable for losses or damages, including from unavoidable cancellations or delays; we'll try to reschedule.</li>
<li><strong style="color: #FFFFFF">Inclusion.</strong> FiveFest is committed to diversity and inclusion.</li>
</ul>
<p style="margin: 24px 0 0; color: #E3E3EA">Questions? <a href="mailto:support@sato48.com" style="font-weight: 800; color: #FF6C00">support@sato48.com</a> or the <a href="https://help.sato48.com/en/" style="font-weight: 800; color: #FF6C00">Helpdesk</a>.</p>
<p style="margin: 12px 0 0"><a href={url("resources/fivefest-guidelines-2026/")} style="font-weight: 800; text-decoration: none; color: #FF6C00">Full 2026 FiveFest guidelines →</a></p>
</div>
</div>
</section>

<Footer />

</div>
</Layout>

<style is:global>
.paper a:hover{color:#1F6E87}
</style>
