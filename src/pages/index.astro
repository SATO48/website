---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { href } from "../lib/paths";
import { accentColor, getSettings, getSingleton, heading } from "../lib/content";

// Copy and images come from Keystatic: Home, Announcement bar and Site settings.
const { seo, hero, programs, archive, yearRound, partners } = await getSingleton("home");
const announcement = await getSingleton("announcement");
const { siteName, logo, organization } = await getSettings();
// Offset shadow color on the hero buttons, logo and archive headline.
const shadowColor = "#3996B1";

const home = new URL(href("/"), Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${home}#org`,
      name: siteName,
      alternateName: organization.legalName,
      url: home,
      logo: new URL(href(logo), Astro.site).href,
      email: organization.email,
      foundingDate: organization.foundingYear,
      address: { "@type": "PostalAddress", addressLocality: organization.city, addressRegion: organization.region, addressCountry: "US" },
    },
    { "@type": "WebSite", name: siteName, url: home, publisher: { "@id": `${home}#org` } },
  ],
};
const heroBackground = `background-image: linear-gradient(180deg, rgba(10,14,26,.55) 0%, rgba(10,14,26,.85) 70%, #0A0E1A 100%), url(${href(hero.background)})`;
// Program cards: the white card gets the featured gradient and border.
const cardStyle = (accent: keyof typeof accentColor) =>
  accent === "white"
    ? "background: linear-gradient(160deg, #1C2A45, #141B2D 60%); border: 1px solid #FFFFFF"
    : "background: #141B2D; border: 1px solid #232C40";
---

<Layout title={seo.title} description={seo.description}>
<script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
<div style="font-family: Inter, Arial, sans-serif; background: #0A0E1A; color: #FFFFFF; line-height: 1.5; min-width: 0">

{announcement.show && (
<div style="background: #FF6C00; color: #0A0E1A; font-weight: 800; text-align: center; padding: 10px 16px; font-size: 15px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 6px 10px">
<span>{announcement.text}</span>
<a href={href(announcement.button.href)} target="_blank" rel="noopener" style="background: #0A0E1A; color: #FF6C00; padding: 4px 12px; border-radius: 999px; text-decoration: none; white-space: nowrap">{announcement.button.label}</a>
</div>
)}

<div style="position: sticky; top: 0; z-index: 10">
<Nav />
</div>

<header class="s48-hero" style={`${heroBackground}; position: relative; overflow: hidden; padding: 72px 0 88px`}>
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center">
<div style="flex: 1.05 1 420px; min-width: 0">
<span style="display: inline-block; font-weight: 800; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: #0A0E1A; background: #3996B1; padding: 6px 12px; border-radius: 4px; margin-bottom: 18px">{hero.eyebrow}</span>
<h1 style="margin: 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(40px, 6vw, 76px)" set:html={heading(hero.headline)} />
<p style="font-size: 20px; color: #E3E3EA; margin: 20px 0 32px; max-width: 34ch">{hero.intro}</p>
<div class="hero-ctas" style="display: flex; gap: 16px; flex-wrap: wrap">
<a class="btn-primary" href={href(hero.primaryButton.href)} style={`display: inline-flex; align-items: center; gap: 8px; font-weight: 800; text-decoration: none; border-radius: 999px; padding: 14px 26px; font-size: 16px; letter-spacing: .02em; background: #FF6C00; color: #0A0E1A; border: 3px solid #0A0E1A; box-shadow: 5px 5px 0 ${shadowColor}`}>{hero.primaryButton.label}</a>
<a class="btn-ghost" href={href(hero.secondaryButton.href)} style="display: inline-flex; align-items: center; gap: 8px; font-weight: 800; text-decoration: none; border-radius: 999px; padding: 14px 26px; font-size: 16px; letter-spacing: .02em; border: 2px solid #FFFFFF; color: #FFFFFF">{hero.secondaryButton.label}</a>
</div>
</div>
<div class="hero-logo" style="flex: 1 1 380px; min-width: 0">
<img src={href(hero.logo)} alt={hero.logoAlt} style={`display: block; width: 100%; background: #0A0E1A; padding: 7% 6%; border: 4px solid #000000; box-shadow: 12px 12px 0 ${shadowColor}; transform: rotate(1.5deg); box-sizing: border-box`}>
</div>
</div>
</header>

<div aria-hidden="true" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); height: 10px">
<div style="background: #3996B1"></div>
<div style="background: #FF6C00"></div>
</div>

<section class="band" style="padding: 88px 0">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<div style="display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 24px; margin-bottom: 40px">
<h2 style="margin: 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(32px, 4vw, 48px)" set:html={heading(programs.heading)} />
<p style="margin: 0; color: #B9B9C6; max-width: 46ch">{programs.intro}</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 24px">
{programs.cards.map((card) => (
<article style={`flex: 1 1 300px; min-width: 0; ${cardStyle(card.accent)}; border-radius: 18px; overflow: hidden; display: flex; flex-direction: column`}>
<div style={`height: 10px; background: ${accentColor[card.accent]}`}></div>
<div style="padding: 28px; display: flex; flex-direction: column; gap: 12px; flex: 1">
{card.logo
  ? <img src={href(card.logo)} alt={card.logoAlt ?? ""} style="height: 48px; width: auto; align-self: flex-start; background: #FFFFFF; padding: 6px 10px; border-radius: 8px">
  : card.eyebrow && <span style={`font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: ${accentColor[card.accent]}`}>{card.eyebrow}</span>}
<h3 style="margin: 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; font-size: 28px">{card.title}</h3>
<p style="margin: 0; color: #CFCFDA; flex: 1">{card.body}</p>
{card.links.map((l) => (
<a href={href(l.href)} style={`font-weight: 800; text-decoration: none${l.highlight ? "; color: #FF6C00" : ""}`}>{l.label}</a>
))}
</div>
</article>
))}
</div>
</div>
</section>

<section class="band archive" style="padding: 88px 0; background: #FAF7F0; color: #0A0E1A; overflow: hidden">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 56px; align-items: center">
<div style="flex: 1 1 380px; min-width: 0">
<h2 style="margin: 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(36px, 5vw, 60px)" set:html={heading(archive.headline, `background: #FF6C00; padding: 0 8px; box-shadow: 4px 4px 0 ${shadowColor}`)} />
<p style="font-size: 19px; margin: 20px 0 28px; color: #2B2B33; max-width: 40ch">{archive.body}</p>
<a class="btn-primary" href={href(archive.button.href)} style="display: inline-flex; align-items: center; gap: 8px; font-weight: 800; text-decoration: none; border-radius: 999px; padding: 14px 26px; font-size: 16px; letter-spacing: .02em; background: #FF6C00; color: #0A0E1A; border: 3px solid #0A0E1A; box-shadow: 5px 5px 0 #3996B1">{archive.button.label}</a>
<div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 26px; font-weight: 800; font-size: 13px">
{archive.years.map((year) => (
<span style="border: 2px solid #0A0E1A; border-radius: 999px; padding: 3px 10px">{year}</span>
))}
</div>
</div>
<a href={href(archive.postersLink)} aria-label={archive.button.label.replace(/^\W+/, "")} style="flex: 1.1 1 420px; min-width: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; transform: rotate(-3deg); padding-bottom: 26px">
{archive.posters.map((p, i) => (
<img src={href(p.image)} alt={p.alt} style={`width: 100%; aspect-ratio: 2/3; object-fit: cover; border-radius: 8px; box-shadow: 0 10px 24px rgba(0,0,0,.25)${i % 2 ? "; transform: translateY(26px)" : ""}`}>
))}
</a>
</div>
</section>

<section class="band" style="padding: 88px 0; background: #141B2D">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center">
<div style="flex: 1.2 1 420px; min-width: 0">
<h2 style="margin: 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(30px, 3.6vw, 44px)" set:html={heading(yearRound.headline, "color: #3996B1")} />
<p style="color: #CFCFDA; margin: 14px 0 0; font-size: 18px">{yearRound.body}</p>
</div>
<div style="flex: 1 1 340px; min-width: 0; background: #000000; border-radius: 18px; padding: 32px; text-align: center; border: 1px solid #28324A">
<img src={href(yearRound.logo)} alt={yearRound.logoAlt} style="max-width: 100%">
</div>
</div>
</section>

<section class="band partners" style="padding: 88px 0; background: #FFFFFF; color: #0A0E1A; text-align: center">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<h2 style="margin: 0 0 8px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; font-size: 30px">{partners.heading}</h2>
<p style="color: #555555; margin: 0 0 36px">{partners.intro}</p>
<div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 18px">
{partners.logos.map((p) => (
<div class="partner-cell" style="flex: 1 1 140px; max-width: 220px; box-sizing: border-box; height: 90px; display: grid; place-items: center; border: 1px solid #EEEEEE; border-radius: 12px; padding: 12px"><img class:list={["partner-logo", { "partner-logo-invert": p.invert }]} src={href(p.image)} alt={p.alt} style={`max-height: 66px; max-width: 100%; object-fit: contain${p.invert ? "; filter: invert(1) grayscale(1)" : ""}`}></div>
))}
</div>
</div>
</section>

<Footer />

</div>
</Layout>

<style is:global>
.s48-hero{background-position:center;background-size:cover}
.partner-logo{filter:grayscale(100%);opacity:.8;transition:.2s}
.partner-cell:hover .partner-logo{filter:none;opacity:1}
.partner-cell:hover .partner-logo-invert{filter:invert(1) grayscale(1);opacity:1}
.partners a:hover,.archive a:hover{color:#0A0E1A}
@media (max-width: 820px){
  .hero-logo{order:-1}
  .hero-ctas a{width:100%;justify-content:center}
}
</style>
