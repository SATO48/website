---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { href } from "../lib/paths";
import { accentColor, getSingleton, heading, inline } from "../lib/content";

// Copy and images come from Keystatic: Pages → Film Challenge.
const { seo, header, event, steps, ceremony, inspiration, guidelines, awards, prizes } = await getSingleton("filmChallenge");
const factBorder = (i: number, n: number) => (i < n - 1 ? "1px solid #232C40" : "0");
---

<Layout title={seo.title} description={seo.description}>
<div style="font-family: Inter, Arial, sans-serif; background: #0A0E1A; color: #FFFFFF; line-height: 1.5; min-width: 0">

<div style="position: sticky; top: 0; z-index: 10">
<Nav />
</div>

<header style="padding: 32px 0 56px; border-bottom: 1px solid #1E2638">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<nav aria-label="Breadcrumb" style="font-size: 14px; color: #B9B9C6; margin-bottom: 40px"><a href={href("/")} style="color: #B9B9C6; text-decoration: none">Home</a> <span aria-hidden="true" style="margin: 0 6px">/</span> <span aria-current="page" style="color: #E6E6EE">{header.breadcrumb}</span></nav>
<div style="display: flex; flex-wrap: wrap; gap: 40px 56px; align-items: end">
<div style="flex: 1 1 480px; min-width: 0">
<p style="margin: 0 0 12px; font-size: 13px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #3996B1">{header.eyebrow}</p>
<h1 style="margin: 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(36px, 4.5vw, 56px)">{header.title}</h1>
<p style="font-size: 18px; color: #E3E3EA; margin: 16px 0 0; max-width: 52ch">{header.intro}</p>
</div>
<aside style="flex: 0 1 380px; min-width: 0; background: #141B2D; border: 1px solid #232C40; border-radius: 18px; padding: 24px">
<p style="margin: 0 0 8px; font-size: 13px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #3996B1">{event.label}</p>
<dl style="margin: 0 0 20px">
{event.dates.map((d, i) => (
<div style={`display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: ${factBorder(i, event.dates.length)}`}><dt style="color: #B9B9C6">{d.label}</dt><dd style="margin: 0; font-weight: 800; text-align: right">{d.value}</dd></div>
))}
</dl>
<div style="display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center"><a class="btn-primary" href={href(event.button.href)} style="display: inline-flex; align-items: center; gap: 8px; font-weight: 800; text-decoration: none; border-radius: 999px; padding: 10px 18px; font-size: 14px; letter-spacing: .02em; background: #FF6C00; color: #0A0E1A; border: 3px solid #0A0E1A; box-shadow: 3px 3px 0 #3996B1">{event.button.label}</a><a href="#guidelines" style="font-weight: 800; font-size: 14px; text-decoration: none; color: #E6E6EE">{event.guidelinesLabel}</a></div>
</aside>
</div>
</div>
</header>

<section class="band" style="padding: 88px 0">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<div style="display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 24px; margin-bottom: 40px">
<h2 style="margin: 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(32px, 4vw, 48px)" set:html={heading(steps.heading)} />
<p style="margin: 0; color: #B9B9C6; max-width: 46ch">{steps.intro}</p>
</div>
<ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px">
{steps.items.map((step, i) => (
<li style="min-width: 0; background: #141B2D; border: 1px solid #232C40; border-radius: 18px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<span style={`font-family: 'Archivo Black', 'Arial Black', sans-serif; font-size: 40px; line-height: 1; color: ${accentColor[step.accent]}`}>{i + 1}</span>
<h3 style="margin: 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 24px; line-height: 1.05">{step.title}</h3>
<p style="margin: 0; color: #CFCFDA">{step.body}</p>
</li>
))}
</ol>
</div>
</section>

<section class="band" style="padding: 0 0 88px">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center">
<figure style="flex: 1.1 1 420px; min-width: 0; margin: 0">
<img src={href(ceremony.photo)} alt={ceremony.photoAlt} style="display: block; width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 18px; border: 1px solid #28324A; box-shadow: 12px 12px 0 #3996B1">
</figure>
<div style="flex: 1 1 360px; min-width: 0">
<span style="font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #3996B1">{ceremony.eyebrow}</span>
<h2 style="margin: 12px 0 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(32px, 4vw, 48px)" set:html={heading(ceremony.heading)} />
<p style="color: #CFCFDA; margin: 20px 0 0; font-size: 18px; max-width: 42ch">{ceremony.body}</p>
<p style="margin: 24px 0 0; font-weight: 800; color: #FFFFFF">{ceremony.date}</p>
</div>
</div>
</section>

<section class="band" style="padding: 88px 0; background: #141B2D">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 48px; align-items: start">
<div style="flex: 1 1 380px; min-width: 0">
<span style="font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #3996B1">{inspiration.eyebrow}</span>
<h2 style="margin: 12px 0 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(32px, 4vw, 48px)" set:html={heading(inspiration.heading)} />
<p style="color: #CFCFDA; margin: 20px 0 0; font-size: 18px; max-width: 42ch">{inspiration.body}</p>
<p style="margin: 24px 0 0"><a href={href(inspiration.link.href)} style="font-weight: 800; text-decoration: none; color: #FF6C00">{inspiration.link.label}</a></p>
</div>
<article style="flex: 1.2 1 440px; min-width: 0; background: #0A0E1A; border: 1px solid #28324A; border-radius: 18px; padding: 32px; box-shadow: 12px 12px 0 #3996B1">
<p style="margin: 0; font-size: 13px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #B9B9C6">{inspiration.packageLabel}</p>
<h3 style="margin: 10px 0 20px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 30px; line-height: 1.05">{inspiration.packageTitle}</h3>
<div class="ip-elements" set:html={inspiration.elements} />
{inspiration.prohibition && <p class="ip-prohibition" style="margin: 20px 0 0; padding-top: 16px; border-top: 1px solid #1E2638; color: #CFCFDA" set:html={inline(inspiration.prohibition)} />}
</article>
</div>
</section>

<section id="guidelines" class="band paper" style="padding: 88px 0; background: #FAF7F0; color: #0A0E1A">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<div style="display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 24px; margin-bottom: 40px">
<div>
<span style="font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #1F6E87">{guidelines.eyebrow}</span>
<h2 style="margin: 12px 0 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(32px, 4vw, 48px)" set:html={heading(guidelines.heading)} />
</div>
<p style="margin: 0; color: #2B2B33; max-width: 46ch">{guidelines.intro}</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px">
{guidelines.cards.map((card) => (
<article style="background: #FFFFFF; border: 1px solid #EEEEEE; border-radius: 18px; padding: 28px">
<h3 style="margin: 0 0 12px; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; font-size: 22px; line-height: 1.1">{card.title}</h3>
<ul style="margin: 0; padding-left: 20px; display: grid; gap: 6px; color: #2B2B33">
{card.points.map((point) => <li>{point}</li>)}
</ul>
</article>
))}
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 32px; font-weight: 800">
{guidelines.links.map((l) => (
<a href={href(l.href)} style="text-decoration: none; color: #1F6E87">{l.label}</a>
))}
</div>
</div>
</section>

<section class="band" style="padding: 88px 0">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<div style="display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 24px; margin-bottom: 40px">
<h2 style="margin: 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(32px, 4vw, 48px)" set:html={heading(awards.heading)} />
<p style="margin: 0; color: #B9B9C6; max-width: 46ch">{awards.intro}</p>
</div>
<dl style="margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1px; background: #232C40; border: 1px solid #232C40; border-radius: 18px; overflow: hidden">
{awards.items.map((a) => (
<div style="background: #141B2D; padding: 24px"><dt style={`font-weight: 800${a.color === "white" ? "" : `; color: ${accentColor[a.color]}`}`}>{a.name}</dt><dd style="margin: 6px 0 0; color: #CFCFDA">{a.description}</dd></div>
))}
<div style="background: #1C2A45; padding: 24px; display: flex; align-items: flex-end"><a href={href(awards.link.href)} style="font-weight: 800; text-decoration: none; color: #FF6C00">{awards.link.label}</a></div>
</dl>
</div>
</section>

<section class="band" style="padding: 0 0 88px">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px">
<div style="display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 24px; margin-bottom: 40px">
<h2 style="margin: 0; font-family: 'Archivo Black', 'Arial Black', sans-serif; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; font-size: clamp(30px, 3.6vw, 40px)" set:html={heading(prizes.heading)} />
<p style="margin: 0; color: #B9B9C6; max-width: 46ch">{prizes.intro}</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 20px">
{prizes.items.map((p) => (
<article style="flex: 1 1 260px; min-width: 0; border: 1px solid #232C40; border-radius: 18px; padding: 24px"><h3 style="margin: 0; font-size: 18px; font-weight: 800">{p.name}</h3><p style="margin: 4px 0 10px; font-size: 13px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #3996B1">{p.sponsor}</p><p style="margin: 0; color: #CFCFDA">{p.description}</p></article>
))}
</div>
<p style="margin: 32px 0 0"><a href={href(prizes.link.href)} style="font-weight: 800; text-decoration: none; color: #FF6C00">{prizes.link.label}</a></p>
</div>
</section>

<Footer />

</div>
</Layout>

<style is:global>
.paper a:hover{color:#1F6E87}
/* Inspiration Package elements and prohibition (rich text from Keystatic) */
.ip-elements ol,.ip-elements ul{margin:0;padding-left:22px;display:grid;gap:12px;color:#E3E3EA}
.ip-elements p{margin:0 0 12px;color:#E3E3EA}
.ip-prohibition strong:first-child{color:#FF6C00}
</style>
