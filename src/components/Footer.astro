---
import { url, img } from "../lib/paths";
---

<footer style="font-family: Inter, Arial, sans-serif; color: #FFFFFF; line-height: 1.5; padding: 56px 0 40px; background: #0A0E1A; border-top: 1px solid #1E2638">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 32px">
<div style="flex: 1.4 1 280px; min-width: 0">
<img src={img("3895383ea4894dab2ac8a8e35b39d7d0.svg")} alt="SATO48 2027" style="height: 44px; display: block">
<p style="color: #B9B9C6; margin: 12px 0 0; max-width: 34ch">Every part of SATO48 serves filmmakers first. Help us keep it going.</p>
<div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px">
<a class="btn-pink" href="#" style="display: inline-flex; align-items: center; font-weight: 800; text-decoration: none; border-radius: 999px; padding: 10px 18px; font-size: 14px; letter-spacing: .02em; background: #3996B1; color: #0A0E1A">Donate</a>
<a class="btn-ghost" href="#" style="display: inline-flex; align-items: center; font-weight: 800; text-decoration: none; border-radius: 999px; padding: 10px 18px; font-size: 14px; letter-spacing: .02em; border: 2px solid #FFFFFF; color: #FFFFFF">Support us on Patreon</a>
</div>
</div>
<div style="flex: 1 1 150px; min-width: 0">
<h4 style="margin: 0 0 12px; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: #B9B9C6">Take part</h4>
<ul style="list-style: none; margin: 0; padding: 0; display: grid; gap: 8px">
<li><a href={url("film-challenge/")} style="text-decoration: none; color: #E6E6EE">Film Challenge</a></li>
<li><a href={url("fivefest/")} style="text-decoration: none; color: #E6E6EE">FiveFest</a></li>
<li><a href="#" style="text-decoration: none; color: #E6E6EE">Prime for Development</a></li>
<li><a href="https://portal.sato48.com/" style="text-decoration: none; color: #E6E6EE">Team portal</a></li>
<li><a href={url("resources/")} style="text-decoration: none; color: #E6E6EE">Rules &amp; resources</a></li>
</ul>
</div>
<div style="flex: 1 1 150px; min-width: 0">
<h4 style="margin: 0 0 12px; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: #B9B9C6">Watch</h4>
<ul style="list-style: none; margin: 0; padding: 0; display: grid; gap: 8px">
<li><a href="https://portal.sato48.com/archive" style="text-decoration: none; color: #E6E6EE">The Archive</a></li>
<li><a href="#" style="text-decoration: none; color: #E6E6EE">TV Show</a></li>
<li><a href="#" style="text-decoration: none; color: #E6E6EE">Nominees &amp; Winners</a></li>
</ul>
</div>
<div style="flex: 1 1 150px; min-width: 0">
<h4 style="margin: 0 0 12px; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: #B9B9C6">Follow</h4>
<ul style="list-style: none; margin: 0; padding: 0; display: grid; gap: 8px">
<li><a href="#" style="text-decoration: none; color: #E6E6EE">Facebook</a></li>
<li><a href="#" style="text-decoration: none; color: #E6E6EE">Instagram</a></li>
<li><a href="#" style="text-decoration: none; color: #E6E6EE">YouTube</a></li>
</ul>
</div>
<p style="flex: 1 1 100%; margin: 12px 0 0; color: #7E8699; font-size: 13px; border-top: 1px solid #1E2638; padding-top: 20px">© Hlabeard Productions, LLC · Springfield, Missouri</p>
</div>
</footer>
