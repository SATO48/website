---
import { href } from "../lib/paths";
import { getSettings } from "../lib/content";

const { logo, logoAlt, footer } = await getSettings();
---

<footer style="font-family: Inter, Arial, sans-serif; color: #FFFFFF; line-height: 1.5; padding: 56px 0 40px; background: #0A0E1A; border-top: 1px solid #1E2638">
<div style="max-width: 1160px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 32px">
<div style="flex: 1.4 1 280px; min-width: 0">
<img src={href(logo)} alt={logoAlt} style="height: 44px; display: block">
<p style="color: #B9B9C6; margin: 12px 0 0; max-width: 42ch">{footer.tagline}</p>
</div>
{footer.columns.map((col) => (
<div style="flex: 1 1 150px; min-width: 0">
<h4 style="margin: 0 0 12px; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: #B9B9C6">{col.heading}</h4>
<ul style="list-style: none; margin: 0; padding: 0; display: grid; gap: 8px">
{col.links.map((l) => (
<li><a href={href(l.href)} target={l.newTab ? "_blank" : undefined} rel={l.newTab ? "noopener" : undefined} style="text-decoration: none; color: #E6E6EE">{l.label}</a></li>
))}
</ul>
</div>
))}
<p style="flex: 1 1 100%; margin: 12px 0 0; color: #7E8699; font-size: 13px; border-top: 1px solid #1E2638; padding-top: 20px">{footer.copyright}</p>
</div>
</footer>
